{
  "expo": {
    "name": "记账本（内测）",
    "slug": "expo-test-56",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "expotest56",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.muzil7263.ledger"
    },
    "android": {
      "package": "com.muzil7263.ledger",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#EAF7F8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F9ECEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "允许访问相册，以选择账单图片或分类图标。",
          "cameraPermission": "允许使用相机拍摄小票、订单和支付记录。",
          "microphonePermission": false,
          "colors": {
            "cropToolbarColor": "#F7F7F8",
            "cropToolbarIconColor": "#17212B",
            "cropToolbarActionTextColor": "#F08A55",
            "cropBackButtonIconColor": "#17212B",
            "cropBackgroundColor": "#FFFFFF"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        }
      },
      "eas": {
        "projectId": "bb8b34a3-57d9-48a4-9d58-736718bf1bfa"
      }
    },
    "owner": "superlxy"
  }
}
